diff --git a/crates/zakuro-gpu/shaders/present.frag b/crates/zakuro-gpu/shaders/present.frag
index 83cf292..062b08b 100644
--- a/crates/zakuro-gpu/shaders/present.frag
+++ b/crates/zakuro-gpu/shaders/present.frag
@@ -19,9 +19,10 @@ layout(push_constant) uniform Crop {
     vec4 bounds;
     int mode;
 #ifndef STEREO
-    // 0 the whole screen, 1 a circle as tall as it, centred, with a dark
-    // rim, for a minimap
+    // what of the screen is drawn, see shaped()
     int shape;
+    float radius;
+    float aspect;
 #endif
 #ifdef STEREO
     // how the eyes are shown, 1 in red and cyan, 2 on alternate rows,
@@ -71,20 +72,69 @@ vec3 shown(sampler2D image, vec4 area, vec4 bounds) {
 }
 
 #ifndef STEREO
-// a circle as tall as the screen, its centre the screen's: what lies
-// outside it is not drawn, so the screen under it shows, and a dark rim
-// edges it
-const float ASPECT = 4.0 / 3.0;
-const float RIM = 0.03;
+// the screen's colour this many texels from here
+vec3 around(vec2 texels) {
+    vec2 at = crop.area.xy + uv * crop.area.zw;
+    vec2 size = vec2(textureSize(screen, 0));
+    return texture(screen, clamp(at + texels / size, crop.bounds.xy, crop.bounds.zw)).rgb;
+}
+
+// what of the screen is drawn: 0 all, 1 a circle as tall as it with a dark
+// rim (a minimap; aspect its width over height), 2 a rounded rectangle
+// (radius a share of its height), 3 the ellipse filling it, 4 only what is
+// near white, text, with a dark edge around it to read on anything.
 const vec3 RIM_COLOUR = vec3(0.07, 0.09, 0.13);
-vec3 round_off(vec3 seen) {
-    float r = length((uv - 0.5) * vec2(ASPECT, 1.0));
-    float edge = fwidth(r);
-    if (r > 0.5) {
+bool bright(vec3 c) {
+    // white or pale text on a dark panel; borders and badges are more
+    // saturated or, below, too long
+    float lo = min(c.r, min(c.g, c.b));
+    float hi = max(c.r, max(c.g, c.b));
+    return dot(c, vec3(0.3, 0.59, 0.11)) > 0.42 && hi - lo < 0.62;
+}
+// text there: bright, and not part of a long upright line (a box's side),
+// which letters, about 9 texels tall, are not
+bool texty(vec2 texels) {
+    if (!bright(around(texels))) {
+        return false;
+    }
+    return !(bright(around(texels + vec2(0.0, 8.0))) && bright(around(texels - vec2(0.0, 8.0))));
+}
+vec3 shaped(vec3 seen, int shape, float radius, float aspect) {
+    if (shape == 1) {
+        float r = length((uv - 0.5) * vec2(aspect, 1.0));
+        float edge = fwidth(r);
+        if (r > 0.5) {
+            discard;
+        }
+        return mix(seen, RIM_COLOUR, smoothstep(0.5 - 0.03 - edge, 0.5 - 0.03, r));
+    }
+    if (shape == 2) {
+        vec2 half_size = vec2(aspect, 1.0) * 0.5;
+        vec2 q = abs((uv - 0.5) * vec2(aspect, 1.0)) - half_size + radius;
+        if (length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius > 0.0) {
+            discard;
+        }
+        return seen;
+    }
+    if (shape == 3) {
+        if (length((uv - 0.5) * 2.0) > 1.0) {
+            discard;
+        }
+        return seen;
+    }
+    if (shape == 4) {
+        if (texty(vec2(0.0))) {
+            return seen;
+        }
+        for (int i = 0; i < 8; i++) {
+            float a = float(i) * 0.785398;
+            if (texty(vec2(cos(a), sin(a)) * 1.5)) {
+                return vec3(0.02, 0.03, 0.05);
+            }
+        }
         discard;
     }
-    float rim = smoothstep(0.5 - RIM - edge, 0.5 - RIM, r);
-    return mix(seen, RIM_COLOUR, rim);
+    return seen;
 }
 #endif
 
@@ -108,10 +158,6 @@ void main() {
         colour = vec4((int(gl_FragCoord.y) & 1) == 0 ? left : right, 1.0);
     }
 #else
-    vec3 seen = shown(screen, crop.area, crop.bounds);
-    if (crop.shape == 1) {
-        seen = round_off(seen);
-    }
-    colour = vec4(seen, 1.0);
+    colour = vec4(shaped(shown(screen, crop.area, crop.bounds), crop.shape, crop.radius, crop.aspect), 1.0);
 #endif
 }

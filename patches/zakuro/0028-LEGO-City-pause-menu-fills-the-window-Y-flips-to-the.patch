-        let view = title_hooks::bottom_view(&mut game.system, &mut game.bottom_watch);
+        let view = title_hooks::bottom_view(&mut game.system, &mut game.bottom_watch, game.taps.progress());
         if view != game.bottom_view || map_changed {
             game.bottom_view = view;
             if let Some(backend) = &mut self.backend {

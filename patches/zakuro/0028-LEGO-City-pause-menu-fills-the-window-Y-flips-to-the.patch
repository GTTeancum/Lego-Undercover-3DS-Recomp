-        view = title_hooks::bottom_view(system, &mut watch);
+        view = title_hooks::bottom_view(system, &mut watch, taps.progress());
         ran += 1;
         probe.after_frame(system, frame + 1);
         if outcome != FrameOutcome::Completed {
@@ -1473,6 +1478,7 @@ impl App {
         title_hooks::button_wheel(&mut game.system, &mut game.taps, &mut input);
         title_hooks::stick_motion(&game.system, &mut game.taps, &mut input);
         title_hooks::language_page(&mut game.system, &mut game.taps, &mut input);
+        title_hooks::pause_menu(&game.bottom_view, &mut game.taps, &mut input);
         let map_changed = was_open != game.taps.map_cursor().is_some() || was_full != game.taps.alert_fullscreen();
         game.frame += 1;
         if let Some(recorder) = &mut game.recorder {
@@ -1480,7 +1486,7 @@ impl App {
         }
         game.system.set_input(input);

 /// the language page's flags on the D-pad (see LANGUAGE_FLAGS).
+/// the pause menu: Y flips the window between the menu and the progress
+/// board; B on the board comes back to the menu (and does not leave the
+/// pause menu). The game reads neither X nor Y while paused.
+pub fn pause_menu(view: &BottomView, taps: &mut Taps, input: &mut zakuro_core::services::hid::InputState) {
+    use zakuro_core::services::hid::PadState;
+    let pressed = input.buttons & !taps.pause_held;
+    taps.pause_held = input.buttons;
+    // a button that did something here stays from the game until let go
+    taps.pause_swallow &= input.buttons;
+    if !view.paused {
+        taps.progress = false;
+        input.buttons.remove(taps.pause_swallow);
+        return;
+    }
+    if pressed.contains(PadState::Y) {
+        taps.progress = !taps.progress;
+    } else if taps.progress && pressed.contains(PadState::B) {
+        taps.progress = false;
+        taps.pause_swallow |= PadState::B;
+    }
+    input.buttons.remove(taps.pause_swallow);
+    input.buttons.remove(PadState::Y);
+    if taps.progress {
+        // the menu does not see the buttons while the board shows, apart
+        // from L and R, the board's own (its areas)
+        input.buttons &= PadState::L | PadState::R;
+    }
+}
+
 pub fn language_page(system: &mut System, taps: &mut Taps, input: &mut zakuro_core::services::hid::InputState) {
     use zakuro_core::services::hid::PadState;
     if system.title.as_ref().map(|title| title.program_id()) != Some(LEGO_CITY_CHASE_BEGINS) {
@@ -454,6 +503,11 @@ impl Taps {
     /// stick points at.
     /// where the Disguise Selector's choice is (bottom-screen pixels),
     /// while LB has it.
+    /// the pause menu shows its progress board.
+    pub fn progress(&self) -> bool {
+        self.progress
+    }
+
     pub fn selector_spot(&self) -> Option<(f32, f32)> {
         self.selector.and_then(|selector| selector.spot).or(self.language_flag.map(|k| LANGUAGE_FLAGS[k]))
     }

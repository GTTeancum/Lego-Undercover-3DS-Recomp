 /// where in the shared page Zakuro leaves input the console has no place
 /// for, for game code written for Zakuro (overrides) to read: the magic
-/// "ZKRS", then the right stick's x and y, -1 to 1, up positive, as f32.
+/// "ZKRS", then the right stick's x and y, then the left stick's (the
+/// circle pad's) x and y, each -1 to 1, up positive, as f32.
 /// The console leaves this end of the page unused.
 pub const HOST_RIGHT_STICK: usize = 0xF00;
 
-/// writes the right stick where HOST_RIGHT_STICK says.
-pub fn set_host_right_stick(page: &mut [u8], x: f32, y: f32) {
+/// writes the sticks where HOST_RIGHT_STICK says.
+pub fn set_host_sticks(page: &mut [u8], right: (f32, f32), left: (f32, f32)) {

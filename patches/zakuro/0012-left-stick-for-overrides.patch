+    for (i, value) in [right.0, right.1, left.0, left.1].into_iter().enumerate() {
+        let at = HOST_RIGHT_STICK + 4 + 4 * i;
+        page[at..at + 4].copy_from_slice(&value.to_le_bytes());
+    }
 }
 

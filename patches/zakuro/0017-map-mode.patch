diff --git a/crates/zakuro/src/title_hooks.rs b/crates/zakuro/src/title_hooks.rs
index 25c2bb6..5a9b12f 100644
--- a/crates/zakuro/src/title_hooks.rs
+++ b/crates/zakuro/src/title_hooks.rs
@@ -211,12 +211,68 @@ const TAP_REQUEST: u32 = 0x005A_4F70;
 /// frames a requested tap holds the stylus down, then lets go.
 const TAP_FRAMES: u32 = 4;
 
-/// what tap_input remembers between frames.
+/// what tap_input remembers between frames, map mode included.
 #[derive(Default)]
 pub struct Taps {
     serial: u32,
     left: u32,
     at: (u16, u16),
+    /// map mode: the bottom screen fills the window, the left stick moves
+    /// a cursor over it and A taps there; where the cursor is, while open.
+    map_cursor: Option<(f32, f32)>,
+    /// the buttons held last frame, for presses.
+    held: zakuro_core::services::hid::PadState,
+}
+
+impl Taps {
+    /// where map mode's cursor is on the bottom screen (pixels), while it
+    /// is open.
+    pub fn map_cursor(&self) -> Option<(f32, f32)> {
+        self.map_cursor
+    }
+}
+
+/// bottom-screen pixels the cursor moves a frame with the stick held all
+/// the way.
+const CURSOR_SPEED: f32 = 4.0;
+
+/// map mode, from the controller: D-pad Up while the map shows opens it,
+/// B or D-pad Up closes it, as does the map going away. While it is open
+/// the game sees none of the controller, only the taps A asks for.
+pub fn map_mode(view: &BottomView, taps: &mut Taps, input: &mut zakuro_core::services::hid::InputState) {
+    use zakuro_core::services::hid::PadState;
+    let pressed = input.buttons & !taps.held;
+    taps.held = input.buttons;
+    let map_shows = view.round || taps.map_cursor.is_some() && !view.hide && view.pieces.is_empty();
+    match taps.map_cursor {
+        None => {
+            if map_shows && view.round && pressed.contains(PadState::UP) {
+                taps.map_cursor = Some((160.0, 120.0));
+                input.buttons.remove(PadState::UP);
+            }
+        }
+        Some((mut x, mut y)) => {
+            if !map_shows || pressed.intersects(PadState::B | PadState::UP) {
+                taps.map_cursor = None;
+            } else {
+                x = (x + input.circle_x * CURSOR_SPEED).clamp(0.0, 319.0);
+                y = (y - input.circle_y * CURSOR_SPEED).clamp(0.0, 239.0);
+                taps.map_cursor = Some((x, y));
+                if pressed.contains(PadState::A) {
+                    taps.at = (x as u16, y as u16);
+                    taps.left = TAP_FRAMES;
+                }
+            }
+            // the controller is the cursor's now
+            let touch = input.touch;
+            *input = Default::default();
+            input.touch = touch;
+            if taps.left > 0 && input.touch.is_none() {
+                taps.left -= 1;
+                input.touch = Some(taps.at);
+            }
+        }
+    }
 }
 

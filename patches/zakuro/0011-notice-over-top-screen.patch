+/// the part of the bottom screen that shows a notice by itself, and how big
+/// to draw it over the top screen, while the game shows one there.
+pub fn bottom_screen_notice(system: &mut System) -> Option<zakuro_gpu::Inset> {
+    match system.title.as_ref().map(|title| title.program_id()) {
+        Some(LEGO_CITY_CHASE_BEGINS) => {
+            let mut word = [0u8; 4];
+            system.memory.read_bytes(NOTICE_STATE, &mut word);
+            // the box spans x 10-309, y 66-173 of 320x240, its "!" above
+            // and badge below it reaching y 50-200
+            (u32::from_le_bytes(word) != 0).then_some(zakuro_gpu::Inset {
+                crop: [6.0 / 320.0, 50.0 / 240.0, 308.0 / 320.0, 150.0 / 240.0],
+                scale: 0.8,
+            })
+        }
+        _ => None,
+    }

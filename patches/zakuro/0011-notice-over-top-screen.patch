@@ -89,6 +89,39 @@ pub struct Viewport {
     pub height: f32,
 }
 
+/// a part of the bottom screen drawn on its own over the middle of the top
+/// screen, in place of the whole bottom screen: crop is the part, as a
+/// fraction of the screen (x, y, width, height from the top left), and
+/// scale its size against the top screen's pixels.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Inset {
+    pub crop: [f32; 4],
+    pub scale: f32,
+}
+
+/// moves the bottom screen's place to where an inset puts it: centred on
+/// the top screen, crop's size at the top screen's scale times inset.scale.
+pub fn apply_inset(places: &mut [(Viewport, Shown)], inset: Option<Inset>) {
+    let Some(inset) = inset else { return };
+    let Some(top) = places.iter().find(|(_, shown)| matches!(shown, Shown::Top | Shown::Both)).map(|(v, _)| *v) else {
+        return;
+    };
+    // the top screen's pixels: 240 rows over its height
+    let pixel = top.height / 240.0;
+    let width = 320.0 * inset.crop[2] * pixel * inset.scale;
+    let height = 240.0 * inset.crop[3] * pixel * inset.scale;
+    for (viewport, shown) in places.iter_mut() {
+        if *shown == Shown::Bottom {
+            *viewport = Viewport {
+                x: top.x + (top.width - width) / 2.0,
+                y: top.y + (top.height - height) / 2.0,
+                width,
+                height,
+            };
+        }
+    }
+}

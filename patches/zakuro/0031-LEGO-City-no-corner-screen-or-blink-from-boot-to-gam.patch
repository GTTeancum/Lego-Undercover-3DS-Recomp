+        if shut[0] != 0 && ran(MISSION_CARD) && mission_card_look(system) {
             return BottomView { hide: false, pieces: vec![piece([98.0, 4.0, 124.0, 52.0], 0.5, 0.13, 1.0, PieceShape::Rounded(0.25))], round: false, swap: false, paused: false };
         }
         return BottomView { hide: true, pieces: Vec::new(), round: false, swap: false, paused: false };
@@ -229,7 +340,6 @@ pub fn bottom_view(system: &mut System, watch: &mut Watch, progress: bool) -> Bo
     // a screen only drawn on the bottom (boot, its alerts and questions,
     // the language picker), the top one black: the bottom fills the window;
     // both black, neither is worth a corner
-    watch.frame += 1;
     if watch.frame % DARK_EVERY == 0 {
         use zakuro_common::Screen;
         watch.dark_top = if system.screen_dark(Screen::Top, DARK_LEVEL) { watch.dark_top.saturating_add(1) } else { 0 };
@@ -249,6 +359,14 @@ pub fn bottom_view(system: &mut System, watch: &mut Watch, progress: bool) -> Bo
     // the Disguise Selector's portraits spread past the round minimap: the
     // bottom screen shows whole while it is open
     let selector = selector_open(system);
+    if ran(MAP) {
+        watch.map_seen = true;
+    }
+    // before the game is under way, a bottom screen nothing above took is
+    // the frontend between its screens: not a corner
+    if !watch.map_seen {
+        return BottomView { hide: true, pieces: Vec::new(), round: false, swap: false, paused: false };
+    }
     BottomView { hide: false, pieces: Vec::new(), round: ran(MAP) && faded_in && !selector, swap: false, paused: false }
 }
 

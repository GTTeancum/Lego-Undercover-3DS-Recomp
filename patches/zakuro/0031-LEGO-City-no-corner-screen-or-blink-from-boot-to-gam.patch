 /// the game runs its logic at 30 frames a second or slower, so a function
@@ -76,12 +89,49 @@ const WIPE_OPENING: u32 = 40;
 const VIDEO_GRACE: u32 = 60;
 /// the loading screen draws less often still while the disc is read.
 const LOADING_GRACE: u32 = 30;
-/// a screen counts as blank after this many dark samples in a row, one
+/// a screen counts as blank after this many dark samples in a row (24
+/// frames: longer than a fade from black), one
 /// every DARK_EVERY frames (boot screens, alerts and the language picker
 /// draw only on the bottom screen, with the top one black).
 const DARK_EVERY: u64 = 4;
-const DARK_SAMPLES: u32 = 2;
+const DARK_SAMPLES: u32 = 6;
 const DARK_LEVEL: u8 = 24;
+/// frames a new layout has to last before it shows, unless it hides the
+/// bottom screen (at once): the game's screens come and go in between for
+/// a frame or a few (fades, a notice closing, the map fading in).
+const SETTLE: u32 = 16;
+/// the mission card's box on the wipe: its left and right edges at x 100
+/// and 218 (y 30) and its bottom at y 52, pale cyan; the bare wipe there is
+/// dark navy or mid blue.
+const MISSION_CARD_BORDER: [(u32, u32); 4] = [(100, 30), (218, 30), (130, 52), (190, 52)];
+
+fn mission_card_look(system: &mut System) -> bool {
+    let pixels = system.screen_pixels(zakuro_common::Screen::Bottom, &MISSION_CARD_BORDER);
+    pixels.iter().all(|&[r, g, b, _]| r > 110 && g > 170 && b > 200)
+}
+/// and once a layout that shows something is up, it stays at least this
+/// many frames before the bottom screen hides (no blink at its end).
+const MIN_SHOW: u32 = 24;
+/// the system notices' look (Checking save data, Saving Game, Preparing
+/// save data, StreetPass, the HOME Button, autosave): a cyan bar across
+/// the bottom screen at y 34-36 with the gold police badge at its left.
+const NOTICE_BAR: [(u32, u32); 4] = [(100, 35), (160, 35), (220, 35), (280, 35)];
+
+fn notice_look(system: &mut System) -> bool {
+    // the bar alone: it is there before the badge and text come in
+    let pixels = system.screen_pixels(zakuro_common::Screen::Bottom, &NOTICE_BAR);
+    // pale cyan, its core near white: bright and bluer than red
+    pixels.iter().all(|&[r, g, b, _]| b > 200 && g > 160 && b > r.saturating_add(20))
+}
+
+/// a video's subtitles: a box with a bright border, its top edge at y
+/// 14-15, its left at x 6-7 (its bottom moves with the lines of text).
+const SUBTITLE_BORDER: [(u32, u32); 4] = [(80, 15), (160, 15), (240, 15), (7, 30)];
+
+fn subtitle_look(system: &mut System) -> bool {
+    let pixels = system.screen_pixels(zakuro_common::Screen::Bottom, &SUBTITLE_BORDER);
+    pixels.iter().all(|&[r, g, b, _]| r.min(g).min(b) > 150)
+}
 
 const MAP: usize = 0;
 const VIDEO: usize = 1;

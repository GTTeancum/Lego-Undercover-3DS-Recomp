@@ -141,6 +192,42 @@ fn read_u32(system: &mut System, address: u32) -> u32 {
 
 /// what the bottom screen shows this frame, as far as the game says.
 pub fn bottom_view(system: &mut System, watch: &mut Watch, progress: bool) -> BottomView {
+    let raw = raw_view(system, watch, progress);
+    // a change that hides the bottom screen, and the pause menu's own
+    // (Y), show at once; any other has to last SETTLE frames first, the
+    // layout shown till then staying
+    watch.shown_for = watch.shown_for.saturating_add(1);
+    let showing = !(watch.shown.hide && watch.shown.pieces.is_empty());
+    if raw == watch.shown {
+        watch.pending = None;
+    } else if raw.paused || watch.shown.paused {
+        watch.shown = raw;
+        watch.shown_for = 0;
+        watch.pending = None;
+    } else if raw.hide && raw.pieces.is_empty() {
+        if !showing || watch.shown_for >= MIN_SHOW {
+            watch.shown = raw;
+            watch.shown_for = 0;
+            watch.pending = None;
+        }
+    } else {
+        let frames = match &watch.pending {
+            Some((view, frames)) if *view == raw => frames + 1,
+            _ => 1,
+        };
+        if frames >= SETTLE {
+            watch.shown = raw;
+            watch.shown_for = 0;
+            watch.pending = None;
+        } else {
+            watch.pending = Some((raw, frames));
+        }
+    }
+    watch.shown.clone()
+}
+
+fn raw_view(system: &mut System, watch: &mut Watch, progress: bool) -> BottomView {
+    watch.frame += 1;
     if system.title.as_ref().map(|title| title.program_id()) != Some(LEGO_CITY_CHASE_BEGINS) {
         return BottomView::default();
     }
@@ -165,11 +252,33 @@ pub fn bottom_view(system: &mut System, watch: &mut Watch, progress: bool) -> Bo
     // taken inside its border); just
     // their text goes along the bottom of the top screen
     if ran_video(VIDEO) {
-        let pieces = if ran_video(TEXT) { vec![piece([12.0, 18.0, 295.0, 64.0], 0.5, 0.87, 0.85, PieceShape::Text)] } else { Vec::new() };
+        // (a short video plays as the hexagon wipe closes: no subtitles,
+        // the bottom screen shows the wipe)
+        let wiped = watch.since_wipe <= WIPE_OPENING;
+        // (the box seen lately: it goes between lines)
+        if watch.frame % DARK_EVERY == 0 && subtitle_look(system) {
+            watch.subtitle = 0;
+            watch.subtitle_seen = true;
+        } else {
+            watch.subtitle = watch.subtitle.saturating_add(1);
+        }
+        let pieces = if ran_video(TEXT) && !wiped && watch.subtitle_seen && watch.subtitle <= VIDEO_GRACE { vec![piece([12.0, 18.0, 295.0, 64.0], 0.5, 0.87, 0.85, PieceShape::Text)] } else { Vec::new() };
         return BottomView { hide: pieces.is_empty(), pieces, round: false, swap: false, paused: false };
     }
     // the loading screen: overrides/tip_text.c has the game print its tip
     // on the top screen, so nothing of the bottom one is needed
+    // the boot splash: the publisher logos on top, the copyright text on
+    // the bottom one, which is left out
+    if ran(SPLASH) {
+        return BottomView { hide: true, pieces: Vec::new(), round: false, swap: false, paused: false };
+    }
+    // a system notice (Checking save data, Saving Game...) fills the window
+    if watch.frame % DARK_EVERY == 0 {
+        watch.notice = if notice_look(system) { watch.notice.saturating_add(1) } else { 0 };
+    }
+    if watch.notice >= 1 {
+        return BottomView { hide: false, pieces: Vec::new(), round: false, swap: true, paused: false };
+    }
     if watch.quiet[LOADING] <= LOADING_GRACE {
         return BottomView { hide: true, pieces: Vec::new(), round: false, swap: false, paused: false };
     }
@@ -211,7 +320,9 @@ pub fn bottom_view(system: &mut System, watch: &mut Watch, progress: bool) -> Bo
     // it shows the mission's name (box x 100-219, y 6-53), that box goes to
     // the top middle of the top screen
     if watch.since_wipe <= WIPE_OPENING {
-        if shut[0] != 0 && ran(MISSION_CARD) {
+        // (the card's function also runs on the loading screen and as the

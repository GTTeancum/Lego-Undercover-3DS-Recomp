From b9e24bab818fc1ffda11a5310ff45d070c88e041 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 03:03:27 +0000
Subject: [PATCH] LEGO City: no corner screen or blink from boot to gameplay

System notices (their cyan bar) fill the window, the boot splash hides
the bottom screen (copyright text), the frontend's bare backdrops are
hidden (no corner before the map has shown), subtitles and the mission
card need their box on screen, a black top screen counts only after 24
frames. Every layout change settles: a new one lasts 16 frames before it
shows, and one that shows stays 24 before the bottom screen hides.
---
 crates/zakuro-core/src/lib.rs    |  28 +++++++
 crates/zakuro/src/title_hooks.rs | 130 +++++++++++++++++++++++++++++--
 2 files changed, 152 insertions(+), 6 deletions(-)

diff --git a/crates/zakuro-core/src/lib.rs b/crates/zakuro-core/src/lib.rs
index ad15365..8f9f848 100644
--- a/crates/zakuro-core/src/lib.rs
+++ b/crates/zakuro-core/src/lib.rs
@@ -1266,6 +1266,34 @@ impl System {
         true
     }
 
+    /// some of a screen's pixels, RGBA, at (x, y) in its pixels.
+    pub fn screen_pixels(&mut self, screen: zakuro_common::Screen, points: &[(u32, u32)]) -> Vec<[u8; 4]> {
+        let index = match screen {
+            zakuro_common::Screen::Top => 0,
+            zakuro_common::Screen::Bottom => 1,
+        };
+        let config = self.gpu.framebuffers[index];
+        let address = config.address_left();
+        if self.lcd_force_black || address == 0 {
+            return vec![[0, 0, 0, 255]; points.len()];
+        }
+        let (width, height) = (screen.width(), screen.height());
+        let format = config.color_format();
+        let bpp = format.bytes_per_pixel() as u32;
+        let stride = if config.stride == 0 { height * bpp } else { config.stride };
+        let base = services::gsp::physical_to_virtual(self, address);
+        self.sync_gpu(base, stride * width);
+        let mut pixel = vec![0u8; bpp as usize];
+        points
+            .iter()
+            .map(|&(x, y)| {
+                let (x, y) = (x.min(width - 1), y.min(height - 1));
+                self.memory.read_bytes(base + x * stride + (height - 1 - y) * bpp, &mut pixel);
+                format.decode(&pixel)
+            })
+            .collect()
+    }
+
     /// a one-line summary for the window title and the log.
     pub fn status_line(&self) -> String {
         let mut line = format!(

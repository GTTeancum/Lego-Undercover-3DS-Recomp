diff --git a/crates/zakuro/src/title_hooks.rs b/crates/zakuro/src/title_hooks.rs
new file mode 100644
index 0000000..086ad01
--- /dev/null
+++ b/crates/zakuro/src/title_hooks.rs
@@ -0,0 +1,29 @@
+//! What particular games say about themselves, read from where their own
+//! code keeps it, for the frontend to follow.
+//!
+//! LEGO City Undercover: The Chase Begins (USA, 00040000000AD500): the
+//! bottom screen is run by one manager object, a global at 0x00519D94
+//! (the Wii U version's GamePad "DRC" screen). Its per-frame update,
+//! f_002DDD64, closes the hexagon wipe over the bottom screen (the idle
+//! badge screen) while the countdown at +0x498 runs, which f_001EF45C and
+//! the update itself set whenever a cutscene or scripted sequence has the
+//! camera (f_00236104), and keeps whether the wipe is shut at +0x485.
+
+use zakuro_core::System;
+
+const LEGO_CITY_CHASE_BEGINS: u64 = 0x0004_0000_000A_D500;
+const DRC_MANAGER: u32 = 0x0051_9D94;
+const DRC_WIPE_SHUT: u32 = DRC_MANAGER + 0x485;
+
+/// whether the bottom screen shows nothing but a game's idle picture, which
+/// a layout that overlays it can leave out.
+pub fn bottom_screen_idle(system: &mut System) -> bool {
+    match system.title.as_ref().map(|title| title.program_id()) {
+        Some(LEGO_CITY_CHASE_BEGINS) => {
+            let mut shut = [0u8];
+            system.memory.read_bytes(DRC_WIPE_SHUT, &mut shut);
+            shut[0] != 0
+        }
+        _ => false,
+    }
+}

+
+/// what bottom_screen_map remembers between frames.
+#[derive(Default)]
+pub struct MapWatch {
+    count: u32,
+    /// frames since the map last ran.
+    quiet: u32,
+}
+
+/// the game runs its logic at 30 frames a second or slower, so the map's
+/// function skips frames; it counts as showing while it ran within these.
+const MAP_GRACE: u32 = 4;
+
+/// whether the bottom screen shows the game's map and nothing over it, which
+/// a layout can draw as a round minimap.
+pub fn bottom_screen_map(system: &mut System, watch: &mut MapWatch) -> bool {
+    match system.title.as_ref().map(|title| title.program_id()) {
+        Some(LEGO_CITY_CHASE_BEGINS) => {
+            let mut word = [0u8; 4];
+            system.memory.read_bytes(MAP_FRAMES, &mut word);
+            let count = u32::from_le_bytes(word);
+            if count != watch.count {
+                watch.count = count;
+                watch.quiet = 0;
+            } else {
+                watch.quiet = watch.quiet.saturating_add(1);
+            }
+            system.memory.read_bytes(DRC_MAP_FADE, &mut word);
+            let faded_in = f32::from_le_bytes(word) > 0.99;
+            let mut shut = [0u8];
+            system.memory.read_bytes(DRC_WIPE_SHUT, &mut shut);
+            watch.quiet <= MAP_GRACE && faded_in && shut[0] == 0
+        }
+        _ => false,
+    }
+}

diff --git a/crates/zakuro-gpu/shaders/present.frag b/crates/zakuro-gpu/shaders/present.frag
index 8890079..83cf292 100644
--- a/crates/zakuro-gpu/shaders/present.frag
+++ b/crates/zakuro-gpu/shaders/present.frag
@@ -18,6 +18,11 @@ layout(push_constant) uniform Crop {
     vec4 area;
     vec4 bounds;
     int mode;
+#ifndef STEREO
+    // 0 the whole screen, 1 a circle as tall as it, centred, with a dark
+    // rim, for a minimap
+    int shape;
+#endif
 #ifdef STEREO
     // how the eyes are shown, 1 in red and cyan, 2 on alternate rows,
     // whether they swap, then where the right eye's picture lies
@@ -65,6 +70,24 @@ vec3 shown(sampler2D image, vec4 area, vec4 bounds) {
     return sum / float(taps.x * taps.y);
 }
 
+#ifndef STEREO
+// a circle as tall as the screen, its centre the screen's: what lies
+// outside it is not drawn, so the screen under it shows, and a dark rim
+// edges it
+const float ASPECT = 4.0 / 3.0;
+const float RIM = 0.03;
+const vec3 RIM_COLOUR = vec3(0.07, 0.09, 0.13);
+vec3 round_off(vec3 seen) {
+    float r = length((uv - 0.5) * vec2(ASPECT, 1.0));
+    float edge = fwidth(r);
+    if (r > 0.5) {
+        discard;
+    }
+    float rim = smoothstep(0.5 - RIM - edge, 0.5 - RIM, r);
+    return mix(seen, RIM_COLOUR, rim);
+}
+#endif
+
 void main() {
 #ifdef STEREO
     vec3 left = shown(screen, crop.area, crop.bounds);
@@ -85,6 +108,10 @@ void main() {
         colour = vec4((int(gl_FragCoord.y) & 1) == 0 ? left : right, 1.0);
     }
 #else
-    colour = vec4(shown(screen, crop.area, crop.bounds), 1.0);
+    vec3 seen = shown(screen, crop.area, crop.bounds);
+    if (crop.shape == 1) {
+        seen = round_off(seen);
+    }
+    colour = vec4(seen, 1.0);
 #endif
 }

+
+#[cfg(unix)]
+fn trace_dump() -> Option<extern "C" fn(u64)> {
+    use std::ffi::{c_char, c_int, c_void, CString};
+    extern "C" {
+        fn dlopen(file: *const c_char, mode: c_int) -> *mut c_void;
+        fn dlsym(handle: *mut c_void, name: *const c_char) -> *mut c_void;
+    }
+    let path = CString::new(std::env::var("ZAKURO_TRACE_LIB").ok()?).ok()?;
+    let name = CString::new("recomp_trace_dump").unwrap();
+    // SAFETY: the library is the one Zakuro already loaded; opening it again
+    // hands back the same one, and the symbol is a fn(uint64_t)
+    unsafe {
+        let handle = dlopen(path.as_ptr(), 2 /* RTLD_NOW */);
+        let symbol = if handle.is_null() { std::ptr::null_mut() } else { dlsym(handle, name.as_ptr()) };
+        if symbol.is_null() {
+            eprintln!("ZAKURO_TRACE_LIB: no recomp_trace_dump in {}", path.to_string_lossy());
+            return None;
+        }
+        Some(std::mem::transmute::<*mut c_void, extern "C" fn(u64)>(symbol))
+    }
+}
+
+#[cfg(not(unix))]
+fn trace_dump() -> Option<extern "C" fn(u64)> {
+    None
 }
 

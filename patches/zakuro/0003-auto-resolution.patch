+    /// how many times the console's resolution the 3D is drawn at: the
+    /// setting, or with it at 0 (auto) enough for the top screen to fill the
+    /// height of the monitor the window is on, 3 when there is no monitor.
+    fn resolution(&self) -> u32 {
+        if self.settings.resolution != 0 {
+            return self.settings.resolution;
+        }
+        let monitor = self.window.as_ref().and_then(|window| window.current_monitor());
+        monitor.map_or(3, |monitor| auto_resolution(monitor.size().height))
+    }

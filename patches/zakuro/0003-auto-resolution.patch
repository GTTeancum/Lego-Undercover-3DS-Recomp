+/// the resolution that draws the top screen's 240 rows at least as tall as
+/// a monitor of this height, 1 to 8.
+fn auto_resolution(monitor_height: u32) -> u32 {
+    monitor_height.div_ceil(240).clamp(1, 8)
+}
+
+#[cfg(test)]
+mod resolution_tests {
+    #[test]
+    fn auto_resolution_fills_the_monitor() {
+        assert_eq!(super::auto_resolution(720), 3);
+        assert_eq!(super::auto_resolution(1080), 5);
+        assert_eq!(super::auto_resolution(1440), 6);
+        assert_eq!(super::auto_resolution(2160), 8);
+        assert_eq!(super::auto_resolution(0), 1);
+    }
+}

@@ -433,6 +436,32 @@ pub fn tap_input(system: &mut System, taps: &mut Taps, input: &mut zakuro_core::
 /// LB on foot: tapped, the character switch; held, a wheel of the buttons
 /// the bottom screen shows, the right stick picking one (the camera holds
 /// still meanwhile) and letting go of LB pressing it.
+/// how fast the right stick turns and tilts the console, radians a frame
+/// at full stick (90 degrees a second), and how far it tilts
+pub const MOTION_SPEED: f32 = 0.026;
+pub const MOTION_TILT_MOST: f32 = 1.2;
+
+/// the right stick as the console's motion, for the game's motion
+/// controls (Move your Nintendo 3DS to look around: observation points;
+/// the wiretap, which sets its reference direction from the gyroscope,
+/// f_0031C7F8): left and right turn the console about its upright axis, up
+/// and down tilt it to look up and down. The gyroscope and accelerometer
+/// then read it as they would the console being moved. Gameplay reads
+/// neither, so the stick goes on driving the camera there (overrides).
+/// Not while map mode or the wheel has the stick.
+pub fn stick_motion(system: &System, taps: &mut Taps, input: &mut zakuro_core::services::hid::InputState) {
+    if system.title.as_ref().map(|title| title.program_id()) != Some(LEGO_CITY_CHASE_BEGINS) {
+        return;
+    }
+    if taps.map_cursor.is_none() && taps.wheel.is_none() {
+        taps.turn += input.c_stick_x * MOTION_SPEED;
+        taps.pitch = (taps.pitch + input.c_stick_y * MOTION_SPEED).clamp(-MOTION_TILT_MOST, MOTION_TILT_MOST);
+    }
+    input.turn += taps.turn;
+    // looking up turns the console's back up: a tilt toward its top
+    input.tilt[1] -= taps.pitch;
+}

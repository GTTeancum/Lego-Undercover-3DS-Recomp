+/// the pause menu's language page (Options, Language) has flags to tap and
+/// no button of the game's on them: the D-pad or left stick moves between
+/// them, A taps one. Their middles, bottom-screen pixels, as this release
+/// (English, Spanish, French) lays them out, in the page's hexagon grid.
+const LANGUAGE_FLAGS: [(f32, f32); 3] = [(57.0, 51.0), (107.0, 80.0), (57.0, 107.0)];
+
+/// the flag nearest the way (dx, dy) points from the one at `from`.
+fn flag_toward(from: usize, (dx, dy): (f32, f32)) -> usize {
+    let (fx, fy) = LANGUAGE_FLAGS[from];
+    LANGUAGE_FLAGS
+        .iter()
+        .enumerate()
+        .filter(|&(k, _)| k != from)
+        .filter_map(|(k, &(x, y))| {
+            let (vx, vy) = (x - fx, y - fy);
+            let distance = vx.hypot(vy);
+            let cosine = (vx * dx + vy * dy) / distance.max(1e-3);
+            (cosine > 0.3).then_some((k, distance / cosine))
+        })
+        .min_by(|a, b| a.1.total_cmp(&b.1))
+        .map_or(from, |(k, _)| k)
+}
+
+/// the language page's flags on the D-pad (see LANGUAGE_FLAGS).
+pub fn language_page(system: &mut System, taps: &mut Taps, input: &mut zakuro_core::services::hid::InputState) {
+    use zakuro_core::services::hid::PadState;
+    if system.title.as_ref().map(|title| title.program_id()) != Some(LEGO_CITY_CHASE_BEGINS) {
+        return;
+    }
+    let count = read_u32(system, COUNTERS + 4 * LANGUAGE_PAGE as u32);
+    if count != taps.language_page_count {
+        taps.language_page_count = count;
+        taps.language_page_quiet = 0;
+    } else {
+        taps.language_page_quiet = taps.language_page_quiet.saturating_add(1);
+    }
+    if taps.language_page_quiet > GRACE {
+        taps.language_flag = None;
+        return;
+    }
+    let current = *taps.language_flag.get_or_insert(0);
+    let pressed = input.buttons & !taps.language_held;
+    taps.language_held = input.buttons;
+    // the left stick, as presses: past half way, after coming back
+    let stick = (input.circle_x, input.circle_y);
+    let stick_way = if stick.0.hypot(stick.1) > 0.6 && !taps.language_stick { Some((stick.0, -stick.1)) } else { None };
+    taps.language_stick = stick.0.hypot(stick.1) > 0.3;
+    let way = if pressed.contains(PadState::UP) {
+        Some((0.0, -1.0))
+    } else if pressed.contains(PadState::DOWN) {
+        Some((0.0, 1.0))
+    } else if pressed.contains(PadState::LEFT) {
+        Some((-1.0, 0.0))
+    } else if pressed.contains(PadState::RIGHT) {
+        Some((1.0, 0.0))
+    } else {
+        stick_way
+    };
+    if let Some(way) = way {
+        taps.language_flag = Some(flag_toward(current, way));
+    }
+    if pressed.contains(PadState::A) {
+        let (x, y) = LANGUAGE_FLAGS[taps.language_flag.unwrap_or(0)];
+        taps.own_touch = Some((pixel((x, y)), TAP_FRAMES));
+    }
+    input.buttons.remove(PadState::A | PadState::UP | PadState::DOWN | PadState::LEFT | PadState::RIGHT);
+    input.circle_x = 0.0;
+    input.circle_y = 0.0;
+    if let Some((at, left)) = taps.own_touch {
+        input.touch = Some(at);
+        taps.own_touch = (left > 1).then_some((at, left - 1));
+    }
+}
+
 pub const WHEEL_NAMES: [&str; 8] = ["Scan", "Exit", "Disguise", "Audio", "Red Bricks", "Free Play", "Hint", "Area exit"];
 /// the character switch's wheel index, LB's when tapped; Scan's, RB's.
 const WHEEL_CHARS: usize = 2;

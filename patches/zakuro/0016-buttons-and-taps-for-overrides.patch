diff --git a/crates/zakuro/src/title_hooks.rs b/crates/zakuro/src/title_hooks.rs
index 23483a5..25c2bb6 100644
--- a/crates/zakuro/src/title_hooks.rs
+++ b/crates/zakuro/src/title_hooks.rs
@@ -203,3 +203,40 @@ pub fn bottom_view(system: &mut System, watch: &mut Watch) -> BottomView {
     let faded_in = f32::from_le_bytes(word) > 0.99;
     BottomView { hide: false, pieces: Vec::new(), round: ran(MAP) && faded_in, swap: false }
 }
+
+/// where overrides (overrides/map_buttons.c) ask for a stylus tap: "TAP!",
+/// x and y in bottom-screen pixels as f32, and a number that changes with
+/// each request.
+const TAP_REQUEST: u32 = 0x005A_4F70;
+/// frames a requested tap holds the stylus down, then lets go.
+const TAP_FRAMES: u32 = 4;
+
+/// what tap_input remembers between frames.
+#[derive(Default)]
+pub struct Taps {
+    serial: u32,
+    left: u32,
+    at: (u16, u16),
+}
+
+/// touches the bottom screen where the game asked for a tap, a few frames,
+/// unless the user is touching it.
+pub fn tap_input(system: &mut System, taps: &mut Taps, input: &mut zakuro_core::services::hid::InputState) {
+    if system.title.as_ref().map(|title| title.program_id()) != Some(LEGO_CITY_CHASE_BEGINS) {
+        return;
+    }
+    if read_u32(system, TAP_REQUEST) == u32::from_le_bytes(*b"TAP!") {
+        let serial = read_u32(system, TAP_REQUEST + 12);
+        if serial != taps.serial {
+            taps.serial = serial;
+            let x = f32::from_bits(read_u32(system, TAP_REQUEST + 4)).clamp(0.0, 319.0);
+            let y = f32::from_bits(read_u32(system, TAP_REQUEST + 8)).clamp(0.0, 239.0);
+            taps.at = (x as u16, y as u16);
+            taps.left = TAP_FRAMES;
+        }
+    }
+    if taps.left > 0 && input.touch.is_none() {
+        taps.left -= 1;
+        input.touch = Some(taps.at);
+    }
+}
